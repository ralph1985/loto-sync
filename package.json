{
  "name": "loto-sync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build",
    "test:unit": "node --experimental-strip-types --test src/features/tickets/create-logic.test.ts src/components/ui/modal-behavior.test.ts src/features/results/data.test.ts src/features/results/line-results.test.ts src/lib/group-balance.test.ts scripts/results-parser.test.mjs scripts/weekly-prizes-lib.test.mjs scripts/weekly-balance-lib.test.mjs",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "backup:db": "node scripts/backup-db.mjs",
    "results:process": "node scripts/process-results-mail.mjs",
    "weekly-prizes:process": "node scripts/process-weekly-prizes.mjs",
    "weekly-balance:send": "node scripts/send-weekly-balance-reports.mjs",
    "results:inspect": "node scripts/inspect-result-email.mjs",
    "recurring-tickets:generate": "node scripts/generate-recurring-tickets.mjs",
    "db:sync:up": "node scripts/sync-db-mirror.mjs up",
    "db:sync:up:force": "node scripts/sync-db-mirror.mjs up --force",
    "db:sync:down": "node scripts/sync-db-mirror.mjs down",
    "db:sync:down:force": "node scripts/sync-db-mirror.mjs down --force"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "imapflow": "1.7.8",
    "mailparser": "3.9.36",
    "next": "16.3.8",
    "nodemailer": "10.0.15",
    "pg": "8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "20.19.30",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "daisyui": "5.0.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.8",
    "husky": "9.0.11",
    "prisma": "7.10.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
